<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.caps</groupId>
    <artifactId>exeris-caps-credential-store</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Exeris Caps :: Credential Store</name>
    <description>
        Layer 5 Domain Primitive capability providing password credential storage,
        Argon2id verification, lockout management, account verification, and credential recovery.
    </description>
    <url>https://github.com/exeris-systems/exeris-caps-credential-store</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <!-- commercial per ADR-023 / ADR-099 — source-available under the Exeris Commercial License -->
    <licenses>
        <license>
            <name>Exeris Commercial License</name>
            <url>https://exeris.eu/licenses/commercial-1.1.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <exeris.sdk.version>0.12.0</exeris.sdk.version>
        <exeris.kernel.version>0.13.0</exeris.kernel.version>
        <exeris.tooling.version>0.10.0</exeris.tooling.version>

        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
            <version>${exeris.sdk.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-lifecycle</artifactId>
            <version>${exeris.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
            <version>${exeris.kernel.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-tck</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-core</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>eu.exeris.caps</groupId>
            <artifactId>exeris-caps-audit-trail</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.exeris</groupId>
                            <artifactId>exeris-processor</artifactId>
                            <version>${exeris.tooling.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-codegen-maven-plugin</artifactId>
                <version>${exeris.tooling.version}</version>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate</goal>
                            <goal>verify-capabilities</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
